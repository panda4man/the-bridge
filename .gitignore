*.log
.DS_Store
.env
# Every .env variant, not the three the Laravel skeleton happened to list.
# `.env.express` — the retired Express app's real configuration, kept after the
# 2026-08-02 cutover — carries SESSION_SECRET, and matching it by name alone
# would leave the next variant someone creates untracked-but-committable.
.env.*
!.env.example
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# --- The Bridge ---------------------------------------------------------
# Runtime state volume. Holds the SQLite database and, critically,
# data/ssh/id_rsa — the private deploy key used to clone every managed
# private repo. Must never be committed.
/data/

# Clone target for managed applications. Contains the full working tree of
# every app this instance deploys, including each of their own .env files.
/repos/

# Reference (Express) SQLite database and WAL sidecars.
bridge.db
bridge.db-shm
bridge.db-wal

# Per-developer MCP client config; carries BRIDGE_API_TOKEN.
.mcp.json

.nvmrc
.venv

# Filament's published vendor assets. Regenerated by `artisan filament:upgrade`
# via composer's post-autoload-dump, so committing them only produces binary
# churn on every dependency change.
/public/css/filament
/public/js/filament
/public/fonts/filament
