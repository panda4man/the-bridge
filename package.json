{
  "name": "the-bridge",
  "version": "1.0.0",
  "description": "Docker deployment manager",
  "private": true,
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx --env-file=.env src/server.ts",
    "worker": "tsx --env-file=.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "better-sqlite3": "^9.6.0",
    "connect-flash": "^0.1.1",
    "ejs": "^3",
    "express": "^4",
    "express-session": "^1",
    "express-validator": "^7",
    "method-override": "^3",
    "simple-git": "^3",
    "tsx": "^4.22.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/connect-flash": "^0.0.40",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/method-override": "^3.0.0",
    "@types/node": "^25.8.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^3",
    "supertest": "^7",
    "typescript": "^6.0.3",
    "vitest": "^3"
  }
}
