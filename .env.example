APP_NAME="The Bridge"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=/data/bridge.sqlite
# DB_USERNAME=root
# DB_PASSWORD=

# The Bridge
#
# This file is read TWICE: by Laravel, and by Docker Compose for the variable
# interpolation in docker-compose.yml. Only the variables docker-compose.yml
# names under `environment:` are actually passed into the container — the rest
# of this file configures local `artisan serve` development.
#
# UPGRADING FROM THE EXPRESS VERSION: REPOS_PATH is now BRIDGE_REPOS_PATH and
# SESSION_SECRET is now APP_KEY. The old names are read by nothing. The
# container entrypoint refuses to boot if REPOS_PATH is set and
# BRIDGE_REPOS_PATH is not, rather than silently falling back to /repos.
#
# BRIDGE_REPOS_PATH is the base directory apps are cloned into. The value below
# is correct for the container, where the host directory is bind-mounted at the
# SAME absolute path so paths stored in the database resolve on both sides.
#
# For local development point this at a writable directory inside the project
# instead — /repos cannot be created on macOS (the root volume is read-only
# under SIP). Use an absolute path, not ./repos: a relative path resolves
# against the process working directory, which differs between `artisan serve`
# and the queue worker that actually runs deploys.
#   BRIDGE_REPOS_PATH=/absolute/path/to/the-bridge-laravel/repos
BRIDGE_REPOS_PATH=/repos

# Container-side path, not host — the key is read only inside the container,
# so this must point under /data (the ./data volume) regardless of where the
# key file actually lives on the host.
BRIDGE_SSH_KEY_PATH=/data/ssh/id_rsa

# Bearer token for the /api routes. Auth fails CLOSED: when this is empty and
# no `api_token` row exists in the settings table, the API returns 503 to every
# caller. Leaving it blank does not make the API public.
BRIDGE_API_TOKEN=

# Initial panel administrator, created once by `artisan db:seed`. The panel has
# no public registration, so without these there is no way to log in. Seeding is
# skipped unless both are set — there is deliberately no default password.
BRIDGE_ADMIN_NAME=Administrator
BRIDGE_ADMIN_EMAIL=
BRIDGE_ADMIN_PASSWORD=

# --- Container only (read by docker-compose.yml, not by Laravel) -----------

# Host port the panel is published on.
BRIDGE_PORT=8080

# Host path of the Docker socket, bind-mounted to /var/run/docker.sock in the
# container. The default below is correct on Linux. Docker Desktop for macOS
# puts it somewhere else entirely, and the wrong value here presents as every
# Docker call failing on a host that looks perfectly healthy. Check with:
#   docker context inspect --format '{{.Endpoints.docker.Host}}'
# macOS (Docker Desktop):
#   DOCKER_SOCK=/Users/you/.docker/run/docker.sock
DOCKER_SOCK=/var/run/docker.sock

# Seconds after which the queue makes a reserved job visible again. Safe at 90
# ONLY because exactly one worker serves the `default` queue (see
# docker/supervisord.conf). Adding a second deploy worker without raising this
# turns every deploy longer than 90 seconds into a duplicate deploy.
DB_QUEUE_RETRY_AFTER=90

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
