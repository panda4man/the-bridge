<%- include('../layouts/header') %>
<h1 class="text-2xl font-bold mb-6">New App</h1>
<form method="POST" action="/apps" class="bg-white rounded shadow p-6 space-y-4 max-w-xl"
    x-data="{ relative: '', skip: false }"
    x-init="relative = $el.dataset.path; skip = $el.dataset.skip === 'true'"
    data-path="<%= old.path || '' %>"
    data-skip="<%= (old.skip_clone === '1' || old.skip_clone === 'true') ? 'true' : 'false' %>">
    <div>
        <label class="block text-sm font-medium mb-1">Name</label>
        <input name="name" value="<%= old.name || '' %>" required
            class="w-full border rounded px-3 py-2 <%= errors.name ? 'border-red-500' : '' %>">
        <% if (errors.name) { %><p class="text-red-600 text-sm mt-1"><%= errors.name.msg %></p><% } %>
    </div>
    <div>
        <label class="block text-sm font-medium mb-1">Repo URL</label>
        <input name="repo_url" value="<%= old.repo_url || '' %>" required
            placeholder="https://github.com/org/repo.git"
            class="w-full border rounded px-3 py-2 <%= errors.repo_url ? 'border-red-500' : '' %>">
        <% if (errors.repo_url) { %><p class="text-red-600 text-sm mt-1"><%= errors.repo_url.msg %></p><% } %>
    </div>
    <div>
        <label class="block text-sm font-medium mb-1">Branch</label>
        <input name="branch" value="<%= old.branch || 'main' %>" required
            class="w-full border rounded px-3 py-2">
    </div>
    <div>
        <label class="flex items-center gap-2 text-sm cursor-pointer select-none">
            <input type="checkbox" name="skip_clone" value="1" x-model="skip" class="rounded border-gray-300">
            Import existing directory <span class="text-gray-400">(skip clone)</span>
        </label>
        <p class="text-gray-400 text-xs mt-1" x-show="skip">
            Directory must already exist on disk and be a git repository.
        </p>
    </div>
    <div>
        <label class="block text-sm font-medium mb-1">Local Path</label>
        <div class="flex rounded border overflow-hidden <%= errors.path ? 'border-red-500' : 'border-gray-300' %>">
            <span class="bg-gray-100 text-gray-500 px-3 py-2 text-sm border-r whitespace-nowrap select-none"><%= reposPath %>/</span>
            <input name="path" x-model="relative" required
                placeholder="my-app"
                class="w-full px-3 py-2 focus:outline-none">
        </div>
        <p class="text-gray-400 text-xs mt-1" x-show="relative.trim()">
            → <span x-text="'<%= reposPath %>/' + relative.trim()"></span>
        </p>
        <% if (errors.path) { %><p class="text-red-600 text-sm mt-1"><%= errors.path.msg %></p><% } %>
    </div>
    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
        <span x-text="skip ? 'Import' : 'Create &amp; Clone'">Create &amp; Clone</span>
    </button>
</form>
<%- include('../layouts/footer') %>
