# Rebuilt inside the image.
/vendor
/node_modules
/public/build
/public/hot

# Filament's published assets. Regenerated by `filament:upgrade` during the
# vendor stage's `composer dump-autoload` — see docs/porting-notes.md,
# "Ignored paths worth knowing about". Copying a host-built copy in would only
# shadow the one the image generates.
/public/css/filament
/public/js/filament
/public/fonts/filament

# Runtime state. /data holds the SQLite database and the private deploy key;
# /repos holds the full working tree of every managed app, including their own
# .env files. Both are volumes at runtime and must never be baked into a layer.
/data
/repos

# Host secrets. The container is configured entirely through compose
# `environment:`; a copied .env would also shadow it, since Laravel's Dotenv
# does not override real environment variables but does supply anything they
# omit.
.env
.env.*
!.env.example
/.mcp.json
/auth.json

# The Express original, kept as the behavioural specification until Phase 8.
# Not part of the running application.
/reference
/bridge-mcp
/my-app

# Not needed at runtime.
/tests
/docs
/.git
/.github
/.claude
/storage/logs/*.log
/.phpunit.cache
.phpunit.result.cache
docker-compose*.yml
.dockerignore
.DS_Store
